  startRoomId: M1_BEDROOM
  isStoryDemo: 1
  plannedChapterCount: 8
  initialItems:
  - {fileID: 11400000, guid: 47570f2c060d48f44bc2edd20d1c8ba0, type: 2}
  initiallyUnlockedRooms:
  - M1_BEDROOM
  - M1_HALL
