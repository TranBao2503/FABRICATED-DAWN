  clues:
  - id: CLUE_SANDBOX_NOTE
    title: "T\u1EDD gi\u1EA5y trong t\u1EE7"
    body: "N\u1ED8I DUNG TH\u1EEC H\u1EC6 TH\u1ED0NG\n\nCh\xECa kh\xF3a \u0111\xE3 m\u1EDF t\u1EE7. Vi\u1EC7c \u0111\u1ECDc t\u1EDD gi\u1EA5y n\xE0y \u0111\u01B0\u1EE3c ghi v\xE0o s\u1ED5 v\xE0 m\u1EDF quy\u1EC1n \u0111i ra h\xE0nh lang.\n\nTrong game ch\xEDnh th\u1EE9c, \u0111i\u1EC1u ki\u1EC7n n\xE0y s\u1EBD \u0111\u01B0\u1EE3c thay b\u1EB1ng chu\u1ED7i manh m\u1ED1i do nh\xF3m thi\u1EBFt k\u1EBF duy\u1EC7t."
  - id: CLUE_SANDBOX_SIGN
    title: "B\u1EA3ng tin h\xE0nh lang"
    body: "B\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh v\xF2ng ch\u01A1i m\u1EABu: nh\u1EB7t \u2192 ch\u1ECDn \u2192 d\xF9ng \u2192 \u0111\u1ECDc \u2192 m\u1EDF l\u1ED1i \u2192 chuy\u1EC3n c\u1EA3nh.\n\nH\xE3y quay l\u1EA1i c\u0103n ph\xF2ng \u0111\u1EC3 ki\u1EC3m tra: \u0111\u1ED3 \u0111\xE3 nh\u1EB7t kh\xF4ng xu\u1EA5t hi\u1EC7n l\u1EA1i, t\u1EE7 v\u1EABn m\u1EDF v\xE0 c\xE1c manh m\u1ED1i v\u1EABn c\xF2n trong s\u1ED5."
  dialogues:
  - id: DIALOGUE_SANDBOX_FRIEND
    speaker: "B\u1EA1n c\xF9ng ph\xF2ng \xB7 tho\u1EA1i th\u1EED"
    lines:
    - "Th\u1EED ki\u1EC3m tra m\u1EB7t b\xE0n xem c\xF3 ch\xECa kh\xF3a kh\xF4ng."
    - "Nh\u1EB7t \u0111\u01B0\u1EE3c r\u1ED3i th\xEC ch\u1ECDn ch\xECa trong t\xFAi \u0111\u1ED3, sau \u0111\xF3 nh\u1EA5n v\xE0o chi\u1EBFc t\u1EE7."
    - "M\xECnh ch\u1EC9 l\xE0 nh\xE2n v\u1EADt th\u1EED h\u1ED9i tho\u1EA1i. T\xEAn v\xE0 l\u1EDDi tho\u1EA1i ch\xEDnh th\u1EE9c s\u1EBD do nh\xF3m ch\u1ED1t sau."
