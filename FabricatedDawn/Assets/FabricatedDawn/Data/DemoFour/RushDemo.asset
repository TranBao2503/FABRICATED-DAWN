  - id: M4_MILESTONE
    title: "Cu\u1ED1i M\xE0n 4 \xB7 ph\xEDa sau c\xE1nh c\u1EEDa"
    subtitle: "M\xC0N 4 \xB7 C\xC1NH C\u1EECA TR\u1EDE V\u1EC0"
    chapter: 4
    ending: 0
    description: 
    narration: "C\u0102N NH\xC0 KH\xD4NG C\xD2N L\u1ED0I RA\n\nB\u1ED1n ng\u01B0\u1EDDi hi\u1EC3u r\u1EB1ng mu\u1ED1n tho\xE1t, h\u1ECD ph\u1EA3i l\u1EA7n l\u1EA1i chuy\u1EC7n c\u0169 ngay trong nh\u1EEFng c\u0103n ph\xF2ng n\xE0y.\n\nM\xE0n 4 ho\xE0n t\u1EA5t \xB7 c\xE2u chuy\u1EC7n c\xF2n ti\u1EBFp."
    isTitleCard: 0
    pastOnly: 1
    presentOnly: 0
    nightScene: 0
    introCard: 0
    placeholderColor: {r: 0.22, g: 0.28, b: 0.24, a: 1}
    presentBackground: {fileID: 21300000, guid: 0a6a9c55379b738449a5cfa4f3d9c243, type: 3}
    pastBackground: {fileID: 21300000, guid: 0a6a9c55379b738449a5cfa4f3d9c243, type: 3}
    hotspots: []
  clues:
  - id: M1_NOTE_CLUE
    title: "L\u1EDDi nh\u1EAFn trong t\u1EE7"
    body: "Nam, x\u1EBFp \u0111\u1ED3 xong th\xEC xu\u1ED1ng \u0103n nh\xE9. Bia \u1EDF ph\xF2ng kh\xE1ch, B\u0103ng lo b\u1EEFa c\u01A1m, B\u1EA3o v\u1EEBa ra h\xE0ng \u0111\u1EA7u ng\xF5.\n\nB\xE0 d\u1EB7n tr\xF4ng nom c\u0103n nh\xE0, \u0111\u1EEBng \u0111\u1EC3 \u0111\u1ED3 ch\u1EAFn c\u1EEDa ph\xF2ng th\u1EDD tr\xEAn g\xE1c. \u2014 Bia"
  - id: M1_BOWL_CLUE
    title: "B\xE1t c\u01A1m th\u1EE9 n\u0103m"
    body: "B\u1ED1n ng\u01B0\u1EDDi, nh\u01B0ng tr\xEAn m\xE2m c\xF3 th\xEAm m\u1ED9t chi\u1EBFc b\xE1t nh\u1ECF m\u1EBB mi\u1EC7ng. Nam nh\xECn k\u1EF9 hoa v\u0103n tr\xEAn th\xE0nh b\xE1t.\n\nV\u1EEBa quay \u0111i h\u1ECFi c\xE1c b\u1EA1n r\u1ED3i nh\xECn l\u1EA1i, chi\u1EBFc b\xE1t \u0111\xE3 kh\xF4ng c\xF2n \u1EDF ch\u1ED7 c\u0169. Ch\u01B0a ai gi\u1EA3i th\xEDch \u0111\u01B0\u1EE3c."
  - id: M1_MIRROR_CLUE
    title: "B\xF3ng ph\xEDa sau trong g\u01B0\u01A1ng"
    body: "Sau khi r\u1EEDa m\u1EB7t, Nam ng\u1EA9ng l\xEAn th\u1EA5y b\xF3ng m\u1ED9t ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF sau l\u01B0ng. Nam ch\u01B0a nh\u1EADn ra \u0111\xF3 l\xE0 ai."
  - id: M1_HAND_CLUE
    title: "D\u1EA5u b\xE0n tay nh\u1ECF"
    body: "Nam quay l\u1EA1i: kh\xF4ng c\xF3 ai. Khi nh\xECn v\u1EC1 g\u01B0\u01A1ng l\u1EA7n n\u1EEFa, s\xE1t m\xE9p d\u01B0\u1EDBi c\xF3 m\u1ED9t d\u1EA5u b\xE0n tay nh\u1ECF. B\u1EC1 m\u1EB7t g\u01B0\u01A1ng v\u1EABn l\u1EA1nh."
  - id: M1_ROUTE_CLUE
    title: "\u0110\u01B0\u1EDDng \u0111\u1EBFn ph\xF2ng th\u1EDD"
    body: "T\u1EA7ng 1: ph\xF2ng kh\xE1ch ph\xEDa tr\u01B0\u1EDBc; ph\xF2ng ng\u1EE7 1 b\xEAn tr\xE1i; c\u1EA7u thang b\xEAn ph\u1EA3i; b\u1EBFp v\xE0 WC 1 ph\xEDa sau, c\u1EEDa ph\u1EE5 ra s\xE2n sau.\n\nT\u1EA7ng 2: h\xE0nh lang gi\u1EEFa nh\xE0; ph\xF2ng ng\u1EE7 2 ph\xEDa tr\u01B0\u1EDBc b\xEAn tr\xE1i; PH\xD2NG TH\u1EDC RI\xCANG ph\xEDa tr\u01B0\u1EDBc b\xEAn ph\u1EA3i; ph\xF2ng ng\u1EE7 3 ph\xEDa sau b\xEAn tr\xE1i; WC 2 ph\xEDa sau b\xEAn ph\u1EA3i.\n\nPh\xF2ng th\u1EDD y\xEAn t\u0129nh kh\xE1c th\u01B0\u1EDDng. K\xFD hi\u1EC7u d\xF2ng h\u1ECD tr\xEAn \u0111\u1ED3 th\u1EDD gi\u1ED1ng v\u1EADt Nam mang b\xEAn m\xECnh. Ch\u01B0a bi\u1EBFt \xFD ngh\u0129a hay t\xE1c d\u1EE5ng."
  - id: M1_DOG_CLUE
    title: "Ch\xF3 s\u1EE7a \u0111\u1EA7u ng\xF5"
    body: "L\xFAc c\u1EA3 nh\xF3m \u0111i qua \u0111\u1EA7u ng\xF5, con ch\xF3 b\u1ED7ng s\u1EE7a. Kh\xF4ng r\xF5 n\xF3 nh\xECn g\xEC; Nam kh\xF4ng quy ti\u1EBFng s\u1EE7a cho m\u1ED9t ng\u01B0\u1EDDi c\u1EE5 th\u1EC3."
  - id: M1_BALLOON_CLUE
    title: "Qu\u1EA3 b\xF3ng \u0111\u1ECF"
    body: "Gi\u1EEFa \u0111\xEAm \u0111i v\u1EC7 sinh, Nam th\u1EA5y m\u1ED9t qu\u1EA3 b\xF3ng \u0111\u1ECF l\u01A1 l\u1EEDng ngo\xE0i h\xE0nh lang, s\u1EE3i d\xE2y c\u0103ng nh\u01B0 c\xF3 ai gi\u1EEF.\n\nL\xFAc quay v\u1EC1, qu\u1EA3 b\xF3ng n\u1EB1m tr\u01B0\u1EDBc ph\xF2ng ng\u1EE7. C\u1EA3nh n\xE0y ch\u1EC9 x\u1EA3y ra m\u1ED9t l\u1EA7n. Kh\xF4ng th\u1EA5y ng\u01B0\u1EDDi c\u1EA7m b\xF3ng."
  - id: M3_LEASE
    title: "Gi\u1EA5y thu\xEA nh\xE0"
    body: "Gi\u1EA5y thu\xEA c\xF3 t\xEAn ng\u01B0\u1EDDi b\xE0 \u0111\u1EE9ng ra cho thu\xEA. B\xE0 n\xF3i c\u0103n nh\xE0 l\xE2u nay ch\u1EC9 \u0111\u1EC3 tr\u1ED1ng; tr\xEAn gi\u1EA5y v\u1EABn c\xF2n t\xEAn m\u1ED9t ng\u01B0\u1EDDi \u0111\xE0n \xF4ng c\xF9ng h\u1ECD b\xEAn n\u1ED9i c\u1EE7a Nam."
  - id: M3_PHOTO
    title: "\u1EA2nh gia \u0111\xECnh ch\u1EE7 c\u0169"
    body: "Trong \u1EA3nh c\xF3 m\u1ED9t ng\u01B0\u1EDDi \u0111\xE0n \xF4ng, v\u1EE3 v\xE0 con g\xE1i. H\u1ECD \u0111\u1EE9ng tr\u01B0\u1EDBc t\u1EE7 g\u1ED7, c\u1EA1nh th\u1ECF v\u1EA3i v\xE0 qu\u1EA3 b\xF3ng \u0111\u1ECF. Sau l\u01B0ng h\u1ECD c\xF2n m\u1ED9t c\u1EEDa ph\xF2ng nh\u1ECF, nay kh\xF4ng th\u1EA5y tr\xEAn h\xE0nh lang."
  - id: M3_FAMILY
    title: "L\u1EDDi ng\u01B0\u1EDDi nh\xE0"
    body: "Ng\u01B0\u1EDDi \u0111\xE0n \xF4ng trong \u1EA3nh thu\u1ED9c h\u1ECD b\xEAn n\u1ED9i c\u1EE7a Nam. K\xFD hi\u1EC7u tr\xEAn v\u1EADt h\u1ED9 th\xE2n l\xE0 d\u1EA5u d\xF2ng h\u1ECD. \u0110\xE2y kh\xF4ng ph\u1EA3i vi\u1EC7c ch\u1EC9 t\xECnh c\u1EDD tr\xF9ng t\xEAn."
  - id: M3_GRANDMA
    title: "L\u1EDDi b\xE0 cho thu\xEA"
    body: "B\xE0 nh\u1EADn con trai \u0111\xE3 m\u1EA5t, nh\u01B0ng n\xE9 chuy\u1EC7n con d\xE2u. L\u1EDDi b\xE0 kh\xF4ng kh\u1EDBp v\u1EDBi vi\u1EC7c b\xE0 t\u1EEBng b\u1EA3o nh\xE0 kh\xF4ng c\xF3 chuy\u1EC7n g\xEC \u0111\xE1ng ng\u1EA1i."
  - id: M3_NEIGHBOR
    title: "L\u1EDDi ng\u01B0\u1EDDi h\xE0ng x\xF3m"
    body: "H\xE0ng x\xF3m k\u1EC3 b\xE9 g\xE1i m\u1EA5t tr\u01B0\u1EDBc; v\u1EC1 sau ng\u01B0\u1EDDi v\u1EE3 gi\u1EBFt ch\u1ED3ng r\u1ED3i t\u1EF1 s\xE1t. \u0110\xE2y m\u1EDBi l\xE0 l\u1EDDi k\u1EC3 c\u1EA7n \u0111\u1ED1i chi\u1EBFu, ch\u01B0a gi\u1EA3i th\xEDch nguy\xEAn nh\xE2n hay to\xE0n b\u1ED9 chuy\u1EC7n trong nh\xE0."
  - id: M3_RENOVATION
    title: "S\u01A1 \u0111\u1ED3 s\u1EEDa nh\xE0"
    body: "C\u1EA7u thang \u1EDF b\xEAn ph\u1EA3i, b\u1EBFp v\xE0 c\u1EEDa ph\u1EE5 ph\xEDa sau. D\u01B0\u1EDBi c\u1EEDa tho\xE1ng \u1EDF chi\u1EBFu ngh\u1EC9 c\xF3 m\u1ED9t \xF4 g\u1EA1ch b\xF4ng khuy\u1EBFt c\xE1nh. \xD4 g\u1EA1ch n\xE0y ch\u01B0a thay d\xF9 c\xE1c ph\xF2ng t\u1EEBng s\u1EEDa l\u1EA1i. M\u1ED9t ph\xF2ng nh\u1ECF c\u1EA1nh ph\xF2ng ng\u1EE7 sau nh\xE0 \u0111\xE3 b\u1ECB b\u1ECBt c\u1EEDa. Ch\u1ED1t c\u1EEDa ph\u1EE5 \u1EE9ng v\u1EDBi d\u1EA5u m\u1ED9t v\u1EA1ch tr\xEAn ch\xECa."
  - id: M4_FIXED_A
    title: "D\u1EA5u m\u1ED1c \u1EDF chi\u1EBFu ngh\u1EC9"
    body: "L\u01B0\u1EE3t th\u1EE9 nh\u1EA5t: d\u01B0\u1EDBi c\u1EEDa tho\xE1ng v\u1EABn l\xE0 \xF4 g\u1EA1ch b\xF4ng khuy\u1EBFt c\xE1nh. Bi\u1EC3n ph\xF2ng v\xE0 h\u01B0\u1EDBng c\u1EA7u thang tr\xF4ng kh\xF4ng gi\u1ED1ng l\xFAc s\xE1ng."
  - id: M4_FIXED_B
    title: "D\u1EA5u m\u1ED1c v\u1EABn c\xF2n nguy\xEAn"
    body: "L\u01B0\u1EE3t k\u1EBF ti\u1EBFp: bi\u1EC3n ph\xF2ng \u0111\xE3 \u0111\u1ED5i, nh\u01B0ng \xF4 g\u1EA1ch khuy\u1EBFt c\xE1nh \u1EDF nguy\xEAn ch\u1ED7. S\u01A1 \u0111\u1ED3 s\u1EEDa nh\xE0 ch\u1EC9 \u0111\u01B0\u1EDDng t\u1EEB \u0111\xE2y v\u1EC1 ph\xEDa b\u1EBFp v\xE0 c\u1EEDa ph\u1EE5."
  - id: M4_EXIT_CLUE
    title: "C\u1EEDa sau kh\xF4ng d\u1EABn ra ng\xF5"
    body: "C\xE1nh c\u1EEDa v\u1EEBa m\u1EDF \u0111\xE3 \u0111\u01B0a c\u1EA3 nh\xF3m tr\u1EDF v\u1EC1 l\u1ED1i v\xE0o. Ph\xEDa sau ch\u1EC9 c\xF2n m\u1ED9t b\u1EE9c t\u01B0\u1EDDng k\xEDn. C\u0103n nh\xE0 v\xE0 \u0111\u1ED3 \u0111\u1EA1c \u0111\u1EC1u \u0111\xE3 \u0111\u1ED5i c\xF9ng m\u1ED9t l\xFAc."
  - id: M4_WINDOW_CLUE
    title: "B\xEAn ngo\xE0i c\u1EEDa s\u1ED5"
    body: "Ngo\xE0i c\u1EEDa s\u1ED5 kh\xF4ng c\xF2n l\xE0 ng\xF5 quen thu\u1ED9c. Nh\u1EEFng kho\u1EA3ng t\u1ED1i kh\xF4ng n\u1ED1i \u0111\u01B0\u1EE3c v\u1EDBi \u0111\u01B0\u1EDDng ph\u1ED1. Kh\xF4ng th\u1EC3 b\u01B0\u1EDBc ra theo l\u1ED1i n\xE0y."
  - id: M4_OBJECT_CLUE
    title: "C\u0103n ph\xF2ng trong \u1EA3nh"
    body: "C\u1EEDa ph\xF2ng t\u1EEBng b\u1ECB s\u1EEDa m\u1EA5t nay \u0111\xE3 xu\u1EA5t hi\u1EC7n. T\u1EE7 g\u1ED7, th\u1ECF v\u1EA3i v\xE0 ch\u1ED7 \u0111\u1EB7t \u0111\u1ED3 \u0111\u1EC1u gi\u1ED1ng \u1EA3nh gia \u0111\xECnh t\xECm \u0111\u01B0\u1EE3c l\xFAc s\xE1ng."
  dialogues:
  - id: M1_BIA_TALK
    speaker: Bia
    clueOnComplete: 
    puzzleOnComplete: 
    lines:
    - "C\u1EADu x\u1EBFp n\u1ED1t s\xE1ch v\u1EDF \u0111i. L\xE1t xu\u1ED1ng \u0103n c\u01A1m, \u0111\u1EEBng \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi \u0111\u1EE3i."
    - "B\xE0 cho thu\xEA r\u1EBB c\u0169ng l\xE0 gi\xFAp b\u1ECDn m\xECnh. Nh\u1EDB tr\xF4ng c\u1EEDa n\u1EBBo cho c\u1EA9n th\u1EADn."
  - id: M1_BANG_TALK
    speaker: "B\u0103ng"
    clueOnComplete: 
    puzzleOnComplete: 
    lines:
    - "H\xF4m nay t\u1EDB n\u1EA5u, mai \u0111\u1EBFn l\u01B0\u1EE3t c\u1EADu \u0111\u1EA5y. B\u1EBFp \u1EDF sau nh\xE0, c\u1EA1nh l\u1ED1i c\u1EA7u thang."
    - "T\u1EDB l\u1EA5y b\u1ED1n c\xE1i b\xE1t r\u1ED3i. \u0102n xong th\xEC ph\u1EE5 nhau r\u1EEDa cho nhanh."
  - id: M1_BAO_TALK
    speaker: "B\u1EA3o"
    clueOnComplete: 
    puzzleOnComplete: 
    lines:
    - "T\u1EDB v\u1EEBa gh\xE9 h\xE0ng \u0111\u1EA7u ng\xF5. Thi\u1EBFu g\xEC th\xEC l\xE1t ra mua, \u0111\u1EEBng \u0111\u1EC3 \u0111\u1EBFn t\u1ED1i."
    - "Nh\xE0 v\u1EABn chia ph\xF2ng nh\u01B0 h\u1ED3i ch\u1EE7 c\u0169 \u1EDF. Ph\xF2ng th\u1EDD tr\xEAn g\xE1c l\xE0 m\u1ED9t ph\xF2ng ri\xEAng, c\u1EADu nh\u1EDB nh\xE9."
  - id: M1_END_TALK
    speaker: "Bia \xB7 B\u0103ng \xB7 B\u1EA3o \xB7 Nam"
    clueOnComplete: 
    puzzleOnComplete: 
    lines:
    - "B\u0103ng: H\xF4m tr\u01B0\u1EDBc ai b\xE0y th\xEAm c\xE1i b\xE1t nh\u1ECF th\u1EBF? T\u1EDB nh\u1EDB m\xECnh ch\u1EC9 l\u1EA5y b\u1ED1n c\xE1i."
    - "Nam: T\u1EDB c\xF2n g\u1EB7p m\u1ED9t qu\u1EA3 b\xF3ng \u0111\u1ECF ngo\xE0i h\xE0nh lang. L\xFAc tr\u1EDF v\u1EC1, n\xF3 \u0111\xE3 n\u1EB1m tr\u01B0\u1EDBc c\u1EEDa ph\xF2ng."
    - "B\u1EA3o: Ch\u1EAFc c\xF3 \u0111\u1EE9a tr\xEAu th\xF4i. Hay b\u1ED1n \u0111\u1EE9a th\u1EED V\u1ED7 Vai Ma m\u1ED9t l\u01B0\u1EE3t cho bi\u1EBFt?"
    - "Bia: Ch\u01A1i m\u1ED9t l\xE1t th\xF4i \u0111\u1EA5y. D\u1ECDn ph\xF2ng kh\xE1ch cho r\u1ED9ng \u0111\xE3."
  - id: DEMO_GAME_DIALOGUE
    speaker: Bia
    clueOnComplete: 
    puzzleOnComplete: 
    lines:
    - "M\u1ED7i \u0111\u1EE9a \u0111\u1EE9ng m\u1ED9t g\xF3c. T\u1EAFt \u0111\xE8n r\u1ED3i ng\u01B0\u1EDDi \u0111\u1EA7u \u0111i d\u1ECDc t\u01B0\u1EDDng, v\u1ED7 vai ng\u01B0\u1EDDi k\u1EBF b\xEAn."
    - "Ai \u0111\u01B0\u1EE3c v\u1ED7 vai th\xEC \u0111i ti\u1EBFp. T\u1EDBi g\xF3c tr\u1ED1ng ph\u1EA3i d\u1EEBng l\u1EA1i. Ch\u1EC9 c\xF3 b\u1ED1n \u0111\u1EE9a m\xECnh th\xF4i."
  - id: RUSH_MANAGER_TALK
    speaker: "B\xE1c qu\u1EA3n l\xFD"
    clueOnComplete: 
    puzzleOnComplete: 
    lines:
    - "B\xE1c nghe c\xE1c ch\xE1u g\u1ECDi n\xEAn l\xEAn xem. D\xE2y \u0111i\u1EC7n nh\xE0 n\xE0y ch\u1EADp ch\u1EDDn, b\xE1c v\u1EEBa n\u1ED1i l\u1EA1i r\u1ED3i."
    - "\u0110\xEAm h\xF4m \u0111\u1EEBng t\u1EE5 t\u1EADp l\xE0m \u1EA7m n\u1EEFa. C\xF3 vi\u1EC7c g\xEC th\xEC s\xE1ng mai h\xE3y h\u1ECFi."
  - id: M3_FAMILY_TALK
    speaker: "Ng\u01B0\u1EDDi nh\xE0 \xB7 qua \u0111i\u1EC7n tho\u1EA1i"
    clueOnComplete: M3_FAMILY
    puzzleOnComplete: 
    lines:
    - "Ng\u01B0\u1EDDi trong \u1EA3nh l\xE0 ng\u01B0\u1EDDi b\xEAn h\u1ECD n\u1ED9i nh\xE0 m\xECnh. D\u1EA5u tr\xEAn v\u1EADt con \u0111eo c\u0169ng l\xE0 d\u1EA5u d\xF2ng h\u1ECD \u1EA5y."
    - "Con h\u1ECFi cho r\xF5 r\u1ED3i h\xE3y t\xEDnh. N\u1EBFu th\u1EA5y kh\xF4ng y\xEAn th\xEC d\u1ECDn \u0111i, \u0111\u1EEBng v\xEC ti\u1EBFc ch\u1ED7 tr\u1ECD r\u1EBB m\xE0 c\u1ED1 \u1EDF."
  - id: M3_GRANDMA_TALK
    speaker: "B\xE0 cho thu\xEA \xB7 qua \u0111i\u1EC7n tho\u1EA1i"
    clueOnComplete: M3_GRANDMA
    puzzleOnComplete: 
    lines:
    - "Con trai b\xE0 m\u1EA5t \u0111\xE3 l\xE2u r\u1ED3i. C\xF2n chuy\u1EC7n con d\xE2u, b\xE0 kh\xF4ng mu\u1ED1n nh\u1EAFc n\u1EEFa."
    - "C\xE1c ch\xE1u c\u1EE9 lo vi\u1EC7c h\u1ECDc \u0111i. Nh\xE0 c\u1EEDa c\xF3 g\xEC th\xEC b\xE1o b\xE0."
  - id: M3_NEIGHBOR_TALK
    speaker: "Ng\u01B0\u1EDDi h\xE0ng x\xF3m"
    clueOnComplete: M3_NEIGHBOR
    puzzleOnComplete: 
    lines:
    - "B\xE1c \u1EDF \u0111\xE2y t\u1EEB tr\u01B0\u1EDBc. Nh\xE0 \u1EA5y c\xF3 \u0111\u1EE9a b\xE9 g\xE1i m\u1EA5t, r\u1ED3i l\u1EA1i x\u1EA3y ra chuy\u1EC7n v\u1EE3 ch\u1ED3ng n\xF3."
    - "Ng\u01B0\u1EDDi v\u1EE3 gi\u1EBFt ch\u1ED3ng r\u1ED3i t\u1EF1 v\u1EABn. B\xE1c ch\u1EC9 bi\u1EBFt chuy\u1EC7n x\u1EA3y ra nh\u01B0 th\u1EBF, c\xF2n \u0111\u1EA7u \u0111u\xF4i th\xEC kh\xF4ng d\xE1m n\xF3i b\u1EEBa."
  - id: M3_ELDER_TALK
    speaker: "Ng\u01B0\u1EDDi bi\u1EBFt vi\u1EC7c th\u1EDD c\xFAng"
    clueOnComplete: M3_RENOVATION
    puzzleOnComplete: M3_ELDER
    lines:
    - "Nh\xE0 \u0111\xE3 s\u1EEDa l\u1ED1i \u0111i, nh\u01B0ng \xF4 g\u1EA1ch d\u01B0\u1EDBi c\u1EEDa tho\xE1ng \u1EDF chi\u1EBFu ngh\u1EC9 v\u1EABn c\xF2n. L\xFAc b\u1ED1i r\u1ED1i, nh\xECn th\u1EE9 quen thu\u1ED9c \u1EA5y m\xE0 \u0111\u1ECBnh \u0111\u01B0\u1EDDng."
    - "C\u1EEDa ph\u1EE5 \u1EDF ph\xEDa b\u1EBFp c\xF3 ch\u1ED1t m\u1ED9t v\u1EA1ch. C\xE1c ch\xE1u c\u1EA7m v\u1EADt n\xE0y, gi\u1EEF b\xEAn m\xECnh. Ta ch\u1EC9 bi\u1EBFt ch\u1EEBng \u1EA5y, kh\xF4ng d\xE1m nh\u1EADn \u0111\xE3 hi\u1EC3u h\u1EBFt chuy\u1EC7n nh\xE0 ng\u01B0\u1EDDi ta."
  - id: M3_PACK_TALK
    speaker: "C\u1EA3 nh\xF3m"
    clueOnComplete: 
    puzzleOnComplete: M3_PACK
    lines:
    - "Nam: Gi\u1EA5y t\u1EDD v\xE0 l\u1EDDi k\u1EC3 \u0111\u1EC1u ch\u1EC9 v\u1EC1 c\u0103n nh\xE0 n\xE0y. B\xE0 \u0111\xE3 gi\u1EA5u chuy\u1EC7n, c\xF2n gia \u0111\xECnh c\u0169 l\u1EA1i c\xF3 quan h\u1EC7 v\u1EDBi nh\xE0 t\u1EDB."
    - "Bia: V\u1EADy d\u1ECDn \u0111i. C\u1EE9 thu x\u1EBFp \u0111\u1ED3, xu\u1ED1ng d\u01B0\u1EDBi r\u1ED3i t\xEDnh ch\u1ED7 kh\xE1c."
    - "B\u0103ng: S\xE1ch v\u1EDF v\u1EDBi qu\u1EA7n \xE1o g\xF3i xong r\u1ED3i. \u0110i c\xF9ng nhau, \u0111\u1EEBng \u0111\u1EC3 ai \u1EDF l\u1EA1i m\u1ED9t m\xECnh."
