  initialObjective: "H\xE0 N\u1ED9i, 2004 \xB7 Nh\u1EEFng ng\xE0y \u1EDF tr\u1ECD"
  objectiveUpdates:
  - afterPuzzle: RUSH_INTRO_DONE
    text: "D\u1ECDn \u0111\u1ED3: t\xECm ch\xECa tr\xEAn b\xE0n, ch\u1ECDn ch\xECa r\u1ED3i m\u1EDF t\u1EE7."
  - afterPuzzle: M1_CABINET
    text: "\u0110\u1ECDc l\u1EDDi nh\u1EAFn trong t\u1EE7 r\u1ED3i xu\u1ED1ng ph\xF2ng kh\xE1ch g\u1EB7p c\xE1c b\u1EA1n."
  - afterPuzzle: M1_NOTE
    text: "Xu\u1ED1ng ph\xF2ng kh\xE1ch: n\xF3i chuy\u1EC7n v\u1EDBi Bia, B\u0103ng, B\u1EA3o v\xE0 xem m\xE2m c\u01A1m."
  - afterPuzzle: M1_BOWL
    text: "\u0110i quanh nh\xE0: r\u1EEDa m\u1EB7t \u1EDF WC 2, xem k\u1EF9 g\u01B0\u01A1ng v\xE0 gh\xE9 ph\xF2ng th\u1EDD ri\xEAng t\u1EA7ng 2."
  - afterPuzzle: M1_ROUTE
    text: "Xem g\u01B0\u01A1ng \u1EDF WC 2 v\xE0 n\xF3i chuy\u1EC7n \u0111\u1EE7 ba ng\u01B0\u1EDDi b\u1EA1n. Xong th\xEC v\u1EC1 ph\xF2ng ng\u1EE7 ngh\u1EC9."
  - afterPuzzle: M1_NIGHT
    text: "N\u1EEDa \u0111\xEAm: ra h\xE0nh lang, quan s\xE1t b\xF3ng \u0111\u1ECF r\u1ED3i \u0111i v\u1EC7 sinh."
  - afterPuzzle: M1_NIGHT_WC
    text: "Tr\u1EDF l\u1EA1i h\xE0nh lang. Qu\u1EA3 b\xF3ng \u0111\xE3 n\u1EB1m tr\u01B0\u1EDBc c\u1EEDa ph\xF2ng ng\u1EE7?"
  - afterPuzzle: M1_BALLOON
    text: "V\u1EC1 ph\xF2ng ng\u1EE7. Nh\u1EEFng ng\xE0y \u1EDF tr\u1ECD v\u1EABn ti\u1EBFp t\u1EE5c\u2026"
  - afterPuzzle: M1_READY
    text: "M\u1ED9t t\u1ED1i kh\xE1c: nghe c\xE1c b\u1EA1n b\xE0n chuy\u1EC7n l\u1EA1. Checkpoint \u0111\u01B0\u1EE3c l\u01B0u tr\u01B0\u1EDBc V\u1ED7 Vai Ma."
  - afterPuzzle: DEMO_GAME_START
    text: "M\xE0n 2: \u0111i theo l\u01B0\u1EE3t qua b\u1ED1n g\xF3c ph\xF2ng."
  - afterPuzzle: DEMO_CORNER_4
    text: "C\xF3 ng\u01B0\u1EDDi \u1EDF g\xF3c tr\u1ED1ng. Ch\u1EA1y ra c\u1EA7u thang!"
  - afterPuzzle: DEMO_M2_COMPLETE
    text: "\u0110\xE3 t\u1EDBi ph\xF2ng th\u1EDD. N\xF3i chuy\u1EC7n v\u1EDBi b\xE1c qu\u1EA3n l\xFD, \u0111\u1EE3i tr\u1EDDi s\xE1ng."
  - afterPuzzle: M3_BEGIN
    text: "T\xECm gi\u1EA5y thu\xEA v\xE0 \u1EA3nh gia \u0111\xECnh; g\u1ECDi v\u1EC1 nh\xE0, h\u1ECFi b\xE0 cho thu\xEA v\xE0 ng\u01B0\u1EDDi h\xE0ng x\xF3m."
  - afterPuzzle: M3_EVIDENCE
    text: "\u0110\u1ED1i chi\u1EBFu gi\u1EA5y thu\xEA, \u1EA3nh, l\u1EDDi ng\u01B0\u1EDDi nh\xE0 v\xE0 l\u1EDDi h\xE0ng x\xF3m \u1EDF b\xE0n ph\xF2ng kh\xE1ch."
  - afterPuzzle: M3_COMPARE
    text: "L\u1EA5y ch\xECa c\u1EEDa ph\u1EE5 trong ng\u0103n t\u1EE7. Gh\xE9 h\xE0ng t\u1EA1p h\xF3a, h\u1ECFi ng\u01B0\u1EDDi bi\u1EBFt vi\u1EC7c th\u1EDD c\xFAng r\u1ED3i nh\u1EADn v\u1EADt tr\u1EA5n."
  - afterPuzzle: M3_PACK
    text: "\u0110\xE3 gom h\xE0nh l\xFD. Th\u1EED xu\u1ED1ng c\u1EA7u thang \u0111\u1EC3 r\u1EDDi c\u0103n nh\xE0."
  - afterPuzzle: M4_BEGIN
    text: "C\u1EA7u thang \u0111\u01B0a nh\xF3m tr\u1EDF l\u1EA1i. Th\u1EED l\u1ED1i \u0111i, ghi l\u1EA1i th\u1EE9 kh\xF4ng \u0111\u1ED5i qua m\u1ED7i l\u01B0\u1EE3t."
  - afterPuzzle: M4_MARK_B
    text: "\u0110\u1ED1i chi\u1EBFu \xF4 g\u1EA1ch d\u01B0\u1EDBi c\u1EEDa tho\xE1ng v\u1EDBi s\u01A1 \u0111\u1ED3 s\u1EEDa nh\xE0. Ch\u1ECDn l\u1ED1i d\u1EABn v\u1EC1 ph\xEDa b\u1EBFp."
  - afterPuzzle: M4_LOOP
    text: "\u0110\xE3 t\xECm \u0111\u01B0\u1EE3c c\u1EEDa ph\u1EE5. Ch\u1ECDn ch\xECa trong t\xFAi r\u1ED3i m\u1EDF ch\u1ED1t theo s\u01A1 \u0111\u1ED3."
  - afterPuzzle: M4_SIDE_DOOR
    text: "C\u1EEDa \u0111\xE3 m\u1EDF kh\xF3a. B\u01B0\u1EDBc qua c\u1EEDa ph\u1EE5 \u0111\u1EC3 t\xECm l\u1ED1i ra."
  - afterPuzzle: M4_CHANGED
    text: "C\u0103n nh\xE0 \u0111\xE3 \u0111\u1ED5i kh\xE1c. Ki\u1EC3m tra c\u1EEDa ra, c\u1EEDa s\u1ED5 v\xE0 c\u0103n ph\xF2ng v\u1EEBa xu\u1EA5t hi\u1EC7n."
  - afterPuzzle: M4_WINDOW
    text: "T\xECm c\u0103n ph\xF2ng gi\u1ED1ng trong \u1EA3nh gia \u0111\xECnh v\xE0 \u0111\u1ED1i chi\u1EBFu \u0111\u1ED3 v\u1EADt b\xEAn trong."
  completedObjective: "M\xE0n 4 ho\xE0n t\u1EA5t. C\u1EA3 nh\xF3m b\u1ECB gi\u1EEF l\u1EA1i trong c\u0103n nh\xE0 c\u0169; c\xE2u chuy\u1EC7n v\u1EABn c\xF2n ti\u1EBFp."
  completionPuzzleId: M4_COMPLETE
