  initialObjective: "Prologue \xB7 C\xF9ng nh\xF3m b\u1EA1n tr\u1EDF v\u1EC1 nh\xE0 tr\u1ECD."
  objectiveUpdates:
  - afterPuzzle: PROLOGUE_DOG_SEEN
    text: "Theo c\xE1c b\u1EA1n v\xE0o ng\xE1ch. Con ch\xF3 v\u1EABn s\u1EE7a ph\xEDa sau."
  - afterPuzzle: PROLOGUE_GROUP_TALKED
    text: "C\xF9ng nh\xF3m tr\u1EDF v\u1EC1 c\u0103n nh\xE0 \u1EDF cu\u1ED1i ng\xE1ch."
  - afterPuzzle: PROLOGUE_DOOR_SEEN
    text: "B\u01B0\u1EDBc qua c\u1EEDa nh\xE0."
  - afterPuzzle: PROLOGUE_DONE
    text: "M\xE0n 1 \xB7 T\xECm ch\xECa kh\xF3a, m\u1EDF t\u1EE7 v\xE0 \u0111\u1ECDc l\u1EDDi nh\u1EAFn tr\u01B0\u1EDBc khi ra kh\u1ECFi ph\xF2ng."
  - afterPuzzle: PUZZLE_CABINET_OPEN
    text: "\u0110\u1ECDc l\u1EDDi nh\u1EAFn trong t\u1EE7."
  - afterPuzzle: PUZZLE_NOTE_READ
    text: "Xu\u1ED1ng ph\xF2ng kh\xE1ch, ki\u1EC3m tra m\xE2m c\u01A1m r\u1ED3i t\xECm \u0111\u01B0\u1EDDng t\u1EDBi ph\xF2ng th\u1EDD."
  - afterPuzzle: DEMO_BOWL
    text: "Tr\u1EDF l\u1EA1i h\xE0nh lang t\u1EA7ng 2 v\xE0 quan s\xE1t ph\xF2ng th\u1EDD."
  - afterPuzzle: DEMO_ROUTE
    text: "\u0110\xE3 thu\u1ED9c \u0111\u01B0\u1EDDng tr\xFA \u1EA9n. Xu\u1ED1ng ph\xF2ng kh\xE1ch n\xF3i chuy\u1EC7n v\u1EDBi c\xE1c b\u1EA1n."
  - afterPuzzle: DEMO_GAME_START
    text: "\u0110i l\u1EA7n l\u01B0\u1EE3t qua b\u1ED1n g\xF3c ph\xF2ng theo lu\u1EADt V\u1ED7 Vai Ma."
  - afterPuzzle: DEMO_CORNER_4
    text: "C\xF3 ng\u01B0\u1EDDi \u1EDF g\xF3c tr\u1ED1ng! Ch\u1EA1y ra c\u1EA7u thang v\xE0 t\xECm t\u1EDBi ph\xF2ng th\u1EDD."
  - afterPuzzle: DEMO_M2_COMPLETE
    text: "M\xE0n 2 ho\xE0n t\u1EA5t. Ti\u1EBFp theo l\xE0 M\xE0n 3 \u2014 Chuy\u1EC7n nh\xE0 ch\u1EE7 c\u0169 (\u0111ang ph\xE1t tri\u1EC3n)."
  completedObjective: "Ho\xE0n t\u1EA5t demo Fabricated Dawn."
