

.s16b-body--overwrite {
    height: 36px;
}

.s16d-file {
    margin-top: 22px;
    padding: 20px 22px;
    border-width: 1px;
    border-color: var(--hcf-cream-16);

    background-color: rgba(10, 9, 8, 0.4);
}

.s16d-file__title {
    height: 30px;
    font-size: 30px;
    color: var(--hcf-cream);
    -unity-text-align: middle-left;
}

.s16d-file__meta {
    margin-top: 8px;
    height: 20px;
    font-size: 17px;
    letter-spacing: 1.4px;
    color: var(--hcf-cream-45);
    -unity-text-align: middle-left;
}

.s16d-actions {
    margin-top: 34px;
}
