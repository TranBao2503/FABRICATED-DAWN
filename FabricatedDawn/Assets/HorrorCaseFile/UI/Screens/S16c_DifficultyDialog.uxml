<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hcf="HorrorCaseFile.UI">
    <Style src="../HorrorCaseFile.uss" />
    <Style src="S16_ConfirmDialog.uss" />
    <Style src="S16b_QuitDialog.uss" />
    <Style src="S16c_DifficultyDialog.uss" />

    <ui:VisualElement name="screen" class="hcf-screen s16 s16b s16c">
        <ui:VisualElement class="hcf-light-pool s16-pool-warm-a" picking-mode="Ignore" />
        <ui:VisualElement class="hcf-light-pool s16-pool-warm-b" picking-mode="Ignore" />
        <ui:VisualElement class="hcf-light-pool s16-pool-dark-a" picking-mode="Ignore" />
        <ui:VisualElement class="hcf-light-pool s16-pool-dark-b" picking-mode="Ignore" />

        <ui:VisualElement name="dim" class="hcf-abs s16-dim" />

        <ui:VisualElement name="dialog" class="hcf-abs s16b-dialog">

            <ui:VisualElement class="s16-dialog__accent s16b-accent--cream" picking-mode="Ignore" />
            <ui:VisualElement class="s16b-dialog__body">
                <ui:Label text="CONFIRM DIFFICULTY" class="hcf-mono s16b-kicker" />
                <ui:Label text="BEGIN ON" class="hcf-display s16b-title__line s16b-title__line--first" />

                <ui:Label name="difficulty-name" text="NIGHTMARE?" class="hcf-display s16b-title__line" />
                <ui:Label name="difficulty-body" text="one save slot, permanent wounds, and no second chances. this cannot be lowered later." class="hcf-typed s16b-body s16b-body--diff" />

                <ui:VisualElement name="threat" class="s16c-threat" picking-mode="Ignore">
                    <ui:VisualElement class="s16c-threat__row">
                        <ui:Label text="THREAT" class="hcf-mono s16c-threat__label" />
                        <ui:Label name="threat-level" text="SEVERE" class="hcf-mono s16c-threat__label" />
                    </ui:VisualElement>
                    <hcf:HcfSegmentedMeter name="meter-threat" class="s16c-threat__meter" segments="5" filled="5" accent-from="0" gap="5" />
                </ui:VisualElement>

                <ui:VisualElement name="actions" class="s16b-actions s16b-actions--row s16c-actions">
                    <ui:Button name="btn-diff-begin" text="" class="hcf-btn hcf-btn--primary s16b-btn--half">
                        <hcf:HcfTornPlate class="hcf-btn__plate" cut-top="3" cut-right="2.2" cut-bottom="1.9" cut-left="2.2" />
                        <hcf:HcfDashedFrame class="hcf-btn__dash" dash="3" gap="3" />
                        <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                        <ui:Label text="BEGIN" class="hcf-btn__label s16b-btn__label" />
                    </ui:Button>
                    <ui:Button name="btn-diff-back" text="" class="hcf-btn hcf-btn--ghost s16b-btn--half s16b-btn--next">
                        <hcf:HcfTornPlate class="hcf-btn__plate" cut-top="3" cut-right="2.2" cut-bottom="1.9" cut-left="2.2" />
                        <hcf:HcfDashedFrame class="hcf-btn__dash" dash="3" gap="3" />
                        <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                        <ui:Label text="BACK" class="hcf-btn__label s16b-btn__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="hints" class="hcf-abs hcf-hint-row s16b-hints">
            <ui:VisualElement class="hcf-hint-item hcf-hint-item--first">
                <ui:Label class="hcf-keycap" text="ENTER" />
                <ui:Label text="begin" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="ESC" />
                <ui:Label text="back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <hcf:HcfGrainOverlay name="grain" grain="55" scanlines="true" />
    </ui:VisualElement>
</ui:UXML>
