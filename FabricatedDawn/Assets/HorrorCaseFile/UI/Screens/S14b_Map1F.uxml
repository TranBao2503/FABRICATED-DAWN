<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hcf="HorrorCaseFile.UI">
    <Style src="../HorrorCaseFile.uss" />
    <Style src="S14_Map.uss" />
    <Style src="S14b_Map1F.uss" />

    <ui:VisualElement name="screen" class="hcf-screen s14 s14b">

        <ui:VisualElement class="hcf-light-pool s14-glow s14b-glow" picking-mode="Ignore" />
        <ui:VisualElement class="hcf-light-pool s14-shade" picking-mode="Ignore" />

        <ui:VisualElement name="header" class="hcf-abs hcf-rule s14-head" picking-mode="Ignore">
            <ui:Label class="hcf-bs-800 s14-head__title" text="FLOORPLAN" />
            <ui:VisualElement class="s14-floors">
                <ui:Button name="tab-b1" text="" class="s14-floor s14-floor--first">
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="B1" />
                </ui:Button>
                <ui:Button name="tab-1f" text="" class="s14-floor is-active">
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="1F" />
                </ui:Button>
                <ui:Button name="tab-2f" text="" class="s14-floor">
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="2F" />
                </ui:Button>

                <ui:Button name="tab-3f" text="" enabled="false" class="s14-floor">
                    <hcf:HcfDashedFrame class="s14-floor__frame" line-width="1" dash="4" gap="4" />
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="3F" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="map-viewport" class="hcf-abs s14-map s14b-map">

            <ui:VisualElement name="map-board" class="s14-board s14-board--1f">

                <ui:VisualElement class="s14-door s14b-door" picking-mode="Ignore" />
                <ui:Label class="hcf-typed s14-door-label s14b-door-label" text="locked — service fob" />

                <ui:Label class="hcf-typed s14b-chained" text="front doors chained shut" />
                <ui:VisualElement class="s14b-down" picking-mode="Ignore">
                    <ui:Label class="hcf-glyph s14b-down__arrow" text="↓" />
                    <ui:Label class="hcf-mono s14b-down__label" text="TO B1" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="floor-panel" class="hcf-abs s14-legend">
            <ui:Label class="hcf-mono s14-legend__caption" text="THIS FLOOR" />
            <ui:Label class="hcf-bs-900 s14b-title s14b-title--first" text="GROUND" />
            <ui:Label class="hcf-bs-900 s14b-title" text="FLOOR" />
            <ui:Label class="hcf-typed s14b-body" text="you came through here in the dark and did not stop to look. most of it is still blank." />

            <ui:VisualElement class="s14-stats s14b-stats">
                <ui:VisualElement class="s14-stat">
                    <ui:Label class="hcf-mono s14-stat__label" text="EXPLORED" />
                    <ui:Label name="stat-explored" class="hcf-bs-700 s14-stat__value" text="21%" />
                </ui:VisualElement>
                <ui:VisualElement class="s14-stat">
                    <ui:Label class="hcf-mono s14-stat__label" text="LOCKED DOORS" />
                    <ui:Label name="stat-locked" class="hcf-bs-700 s14-stat__value" text="2" />
                </ui:VisualElement>
                <ui:VisualElement class="s14-stat">
                    <ui:Label class="hcf-mono s14-stat__label" text="DOCUMENTS HERE" />
                    <ui:Label name="stat-documents" class="hcf-bs-700 s14-stat__value" text="1 / 6" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="hints" class="hcf-abs hcf-hint-row s14-hints">
            <ui:VisualElement class="hcf-hint-item hcf-hint-item--first">
                <ui:Label class="hcf-keycap hcf-keycap--square" text="Q" />
                <ui:Label class="hcf-keycap hcf-keycap--square" text="E" />
                <ui:Label text="floor" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="M" />
                <ui:Label text="close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <hcf:HcfGrainOverlay name="grain" grain="55" scanlines="true" />

    </ui:VisualElement>
</ui:UXML>
