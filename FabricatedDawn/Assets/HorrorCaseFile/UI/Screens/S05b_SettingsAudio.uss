

.s05b-note {
    margin-left: auto;
    padding-bottom: 12px;
    font-size: 18px;

    color: rgba(236, 230, 218, 0.38);
}

.s05b-section {
    height: 16px;
    font-size: 14px;
    letter-spacing: 4.2px;
    color: var(--hcf-cream-40);
    -unity-text-align: middle-left;
}

.s05b-section--levels {
    margin-bottom: 10px;
}

.s05b-section--output {
    margin-top: 24px;
    margin-bottom: 8px;
}

.s05b-options {
    top: 286px;
}

.s05b-row {
    height: 77px;
}

.s05b-row.is-active {
    height: 76px;
    border-bottom-width: 0;
}

.s05b-row--flush {
    height: 76px;
    border-bottom-width: 0;
}

.hcf-seg-group #choicesContentContainer {
    display: none;
}

.hcf-seg-group--cream .unity-radio-button:disabled {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.hcf-seg-group--cream .unity-radio-button:disabled .unity-radio-button__text {
    color: var(--hcf-cream-22);
}

.s05b-seg__dash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    --hcf-dash-color: rgba(236, 230, 218, 0.12);
}

.s05b-side {
    right: 112px;
    top: 300px;
    width: 560px;
}

.s05b-toggles {
    margin-top: 22px;
}

.s05b-toggle {
    height: 38px;
    margin-top: 22px;
}

.s05b-toggle--first {
    margin-top: 0;
}

.s05b-toggle .hcf-check__mark {
    top: 4px;
}

.s05b-toggle .unity-toggle__text {
    font-size: 32px;
}

.s05b-outro {
    margin-top: 38px;
    height: 64px;
    font-size: 20px;
    color: var(--hcf-cream-45);
    white-space: normal;
}

.s05b-tooltip {
    margin-top: 34px;
    padding: 24px 26px;
    border-width: 1px;
    border-color: var(--hcf-cream-14);

    background-color: rgba(10, 9, 8, 0.4);
}

.s05b-tooltip__title {
    height: 16px;
    margin-bottom: 12px;
    font-size: 14px;
    letter-spacing: 3.64px;
    color: var(--hcf-cream-40);
    -unity-text-align: middle-left;
}

.s05b-tooltip__body {
    height: 102px;
    font-size: 20px;
    color: var(--hcf-cream-60);
    white-space: normal;
}
