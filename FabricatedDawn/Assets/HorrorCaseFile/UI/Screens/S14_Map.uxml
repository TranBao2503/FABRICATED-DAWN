<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hcf="HorrorCaseFile.UI">
    <Style src="../HorrorCaseFile.uss" />
    <Style src="S14_Map.uss" />

    <ui:VisualElement name="screen" class="hcf-screen s14">

        <ui:VisualElement class="hcf-light-pool s14-glow" picking-mode="Ignore" />
        <ui:VisualElement class="hcf-light-pool s14-shade" picking-mode="Ignore" />

        <ui:VisualElement name="header" class="hcf-abs hcf-rule s14-head" picking-mode="Ignore">
            <ui:Label class="hcf-bs-800 s14-head__title" text="FLOORPLAN" />

            <ui:VisualElement class="s14-floors">
                <ui:Button name="tab-b1" text="" class="s14-floor s14-floor--first">
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="B1" />
                </ui:Button>
                <ui:Button name="tab-1f" text="" class="s14-floor">
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="1F" />
                </ui:Button>
                <ui:Button name="tab-2f" text="" class="s14-floor is-active">
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="2F" />
                </ui:Button>

                <ui:Button name="tab-3f" text="" enabled="false" class="s14-floor">
                    <hcf:HcfDashedFrame class="s14-floor__frame" line-width="1" dash="4" gap="4" />
                    <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                    <ui:Label class="hcf-bs-700 s14-floor__label" text="3F" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="map-viewport" class="hcf-abs s14-map">

            <ui:VisualElement name="map-board" class="s14-board">

                <ui:VisualElement class="s14-marker" />
                <ui:VisualElement class="s14-marker-ring" />
                <ui:Label class="hcf-typed s14-marker-label" text="you are here" />

                <ui:VisualElement class="s14-door" />
                <ui:Label class="hcf-typed s14-door-label" text="locked — brass" />

                <ui:Label class="hcf-typed s14-warn" text="don't use this stair" />

            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="legend" class="hcf-abs s14-legend">
            <ui:Label class="hcf-mono s14-legend__caption" text="LEGEND" />

            <ui:VisualElement class="s14-legend__list">
                <ui:VisualElement class="s14-legend__row s14-legend__row--first">
                    <ui:VisualElement class="s14-legend__swatch" />
                    <ui:Label class="hcf-typed s14-legend__label" text="explored" />
                </ui:VisualElement>
                <ui:VisualElement class="s14-legend__row">
                    <hcf:HcfDashedFrame class="s14-legend__swatch s14-legend__swatch--dashed" line-width="2" dash="6" gap="5" />
                    <ui:Label class="hcf-typed s14-legend__label" text="unexplored" />
                </ui:VisualElement>
                <ui:VisualElement class="s14-legend__row">
                    <ui:VisualElement class="s14-legend__swatch s14-legend__swatch--locked" />
                    <ui:Label class="hcf-typed s14-legend__label" text="locked door" />
                </ui:VisualElement>
                <ui:VisualElement class="s14-legend__row">
                    <ui:VisualElement class="s14-legend__swatch s14-legend__swatch--pos" />
                    <ui:Label class="hcf-typed s14-legend__label" text="your position" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="s14-stats">
                <ui:VisualElement class="s14-stat">
                    <ui:Label class="hcf-mono s14-stat__label" text="EXPLORED" />
                    <ui:Label name="stat-explored" class="hcf-bs-700 s14-stat__value" text="62%" />
                </ui:VisualElement>
                <ui:VisualElement class="s14-stat">
                    <ui:Label class="hcf-mono s14-stat__label" text="LOCKED DOORS" />
                    <ui:Label name="stat-locked" class="hcf-bs-700 s14-stat__value" text="3" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label class="hcf-typed s14-note" text="the map only fills in where you have actually walked." />
        </ui:VisualElement>

        <ui:VisualElement name="hints" class="hcf-abs hcf-hint-row s14-hints">
            <ui:VisualElement class="hcf-hint-item hcf-hint-item--first">
                <ui:Label class="hcf-keycap" text="DRAG" />
                <ui:Label text="pan" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="SCROLL" />
                <ui:Label text="zoom" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap hcf-keycap--square" text="Q" />
                <ui:Label class="hcf-keycap hcf-keycap--square" text="E" />
                <ui:Label text="floor" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="M" />
                <ui:Label text="close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <hcf:HcfGrainOverlay name="grain" grain="55" scanlines="true" />

    </ui:VisualElement>
</ui:UXML>
