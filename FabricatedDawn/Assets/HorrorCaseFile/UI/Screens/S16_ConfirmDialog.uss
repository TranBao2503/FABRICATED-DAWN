

.s16-pool-warm-a {
    left: -20%;
    top: -7.962963%;
    width: 75.989583%;
    height: 60%;

    -unity-background-image-tint-color: #FFF7E6;
    opacity: 0.045;
}

.s16-pool-warm-b {
    left: 41.979167%;
    top: 52.037037%;
    width: 60%;
    height: 52.037037%;
    -unity-background-image-tint-color: #FFF7E6;
    opacity: 0.035;
}

.s16-pool-dark-a {
    left: 41.979167%;
    top: -27.962963%;
    width: 91.979167%;
    height: 80%;
    -unity-background-image-tint-color: #000000;
    opacity: 0.4;
}

.s16-pool-dark-b {
    left: -25.989583%;
    top: 56.018519%;
    width: 68.020833%;
    height: 60%;
    -unity-background-image-tint-color: #000000;
    opacity: 0.45;
}

.s16-dim {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(6, 5, 5, 0.75);
}

.s16-dialog-shadow {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin-top: 7px;
    width: 1062px;
    height: 589px;
    rotate: -0.5deg;
    opacity: 0.7;
}

.s16-dialog {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin-top: 7px;
    width: 1022px;

    background-color: #1C1A18;
    border-width: 1px;
    border-color: rgba(236, 230, 218, 0.18);
    rotate: -0.5deg;
}

.s16-dialog__accent {
    height: 5px;
    background-color: var(--hcf-rust);
}

.s16-dialog__body {
    padding: 51px 60px 48px;
}

.s16-kicker {
    height: 17px;
    font-size: 15px;
    letter-spacing: 4.8px;
    color: var(--hcf-cream-50);
    -unity-text-align: middle-left;
}

.s16-title__line {
    height: 70px;
    font-size: 76px;
    -unity-text-align: middle-left;
}

.s16-title__line--first {
    margin-top: 18px;
}

.s16-body {
    margin-top: 24px;
    width: 900px;
    height: 75px;
    font-size: 22px;
    color: var(--hcf-cream-60);
    white-space: normal;
}

.s16-actions {
    margin-top: 44px;
    flex-direction: row;
    height: 70px;
}

.s16-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 70px;
}

.s16-btn--second {
    margin-left: 16px;
    border-color: var(--hcf-rust-55);
}

.hcf-kbd .s16-btn--second:focus:enabled {
    border-color: var(--hcf-rust);
}

.s16-btn__label {
    font-size: 30px;
    letter-spacing: 1.8px;
}

.s16-btn--second .hcf-btn__label {

    color: rgba(168, 51, 42, 0.95);
}

.s16-btn--second:active .hcf-btn__label {
    color: var(--hcf-cream);
}

.s16-hints {
    margin-top: 22px;
    height: 30px;
    justify-content: flex-end;
    color: var(--hcf-cream-40);
}

.s16-hints .hcf-hint-item {
    margin-left: 22px;
}

.s16-hints .hcf-hint-item--first {
    margin-left: 0;
}

.s16 .hcf-keycap {
    height: 30px;
    color: var(--hcf-cream-40);
}
