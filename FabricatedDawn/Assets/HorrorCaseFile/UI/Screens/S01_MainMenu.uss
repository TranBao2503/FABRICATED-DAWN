.s01-header {
    left: 112px;
    top: 104px;
    width: 800px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 9px;
}

.s01-header__code {
    font-size: 15px;
    letter-spacing: 5.1px;
    color: var(--hcf-cream-50);
}

.s01-header__date {
    font-size: 18px;
    color: var(--hcf-cream-40);
}

.s01-title {
    left: 108px;
    top: 172px;
    width: 820px;
    height: 250px;
}

.s01-title__layer {
    position: absolute;
}

.s01-title__layer--shadow {
    left: 4px;
    top: 4px;
    opacity: 0.62;
}

.s01-title__layer--main {
    left: 0;
    top: 0;
}

.s01-title__layer .s01-title__line {
    font-size: 150px;
    height: 120px;
    letter-spacing: -1.8px;
    -unity-text-align: middle-left;
}

.s01-title__layer--shadow .s01-title__line {
    color: var(--hcf-rust-deep);
}

.s01-title__layer--main .s01-title__line {
    color: var(--hcf-cream);
}

.s01-menu {
    left: 112px;
    top: 520px;
    width: 700px;
}

.s01-menu-item {
    position: relative;
    height: 74px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    -unity-text-align: upper-left;
}

.s01-menu-item--second {
    margin-top: 17px;
}

.s01-menu-item__plate {
    left: -16px;
    top: 4px;
    width: 610px;
    height: 66px;
}

.s01-menu-item__underline {
    position: absolute;
    display: none;
    left: -6px;
    bottom: -2px;
    width: 520px;
    height: 5px;
    background-color: var(--hcf-rust);
    rotate: -0.5deg;
    opacity: 0.9;
}

.s01-menu-item.is-active .s01-menu-item__underline {
    display: flex;
}

.s01-menu-item__row {
    flex-direction: row;
    align-items: flex-end;
}

.s01-menu-item.is-active .s01-menu-item__row {
    padding-left: 14px;
}

.s01-menu-item__index {
    font-size: 19px;
    margin-bottom: 9px;
    color: rgba(236, 230, 218, 0.34);
}

.s01-menu-item.is-active .s01-menu-item__index {
    color: rgba(26, 24, 23, 0.83);
}

.s01-menu-item__label {
    margin-left: 22px;
    font-size: 52px;
    color: var(--hcf-cream-86);
}

.s01-menu-item.is-active .s01-menu-item__label {
    -unity-font-definition: url("../../Fonts/BigShouldersDisplay-ExtraBold.ttf");
    color: #161413;
}

.s01-menu-item__meta {
    position: absolute;
    left: 640px;
    top: 25px;
    font-size: 18px;
    color: var(--hcf-cream-55);
}

.s01-version {
    left: 112px;
    bottom: 52px;
    font-size: 16px;
    letter-spacing: 1.6px;
    color: rgba(236, 230, 218, 0.34);
}

.s01-hints {
    right: 112px;
    bottom: 44px;
}

.s01-keyart__hatch {
    background-image: url("../../Art/Backdrops/KeyArt_MainMenu.png");
    background-size: 100% 100%;
    background-repeat: no-repeat;
}
