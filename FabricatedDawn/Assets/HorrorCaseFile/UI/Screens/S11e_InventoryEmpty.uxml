            <ui:Label class="hcf-typed s11e-empty__body" text="search drawers, lockers and bodies. anything you can carry will appear here — you can hold twenty-four things and no more." />
            <ui:VisualElement class="s11e-empty__hint">
                <ui:Label class="hcf-keycap s11e-keycap" text="F" />
                <ui:Label class="hcf-mono s11e-empty__hint-label" text="pick up what you find" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="hcf-hint-row hcf-abs s11-hints">
            <ui:VisualElement class="hcf-hint-item hcf-hint-item--first">
                <ui:Label class="hcf-keycap" text="I" />
                <ui:Label text="close" />
            </ui:VisualElement>
