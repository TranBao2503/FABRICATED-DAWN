<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hcf="HorrorCaseFile.UI">
    <Style src="../HorrorCaseFile.uss" />
    <Style src="S11_Inventory.uss" />
    <Style src="S11e_InventoryEmpty.uss" />

    <ui:VisualElement name="screen" class="hcf-screen s11 s11e">
        <ui:VisualElement class="hcf-light-pool s11-pool-warm s11e-pool-warm" picking-mode="Ignore" />
