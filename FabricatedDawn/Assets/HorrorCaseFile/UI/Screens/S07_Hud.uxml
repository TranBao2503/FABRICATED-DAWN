<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hcf="HorrorCaseFile.UI">
    <Style src="../HorrorCaseFile.uss" />
    <Style src="S07_Hud.uss" />

    <ui:VisualElement name="screen" class="hcf-screen s07">

        <ui:VisualElement name="gameplay-view" class="hcf-abs hcf-placeholder s07-gameplay" picking-mode="Ignore" />

        <ui:VisualElement name="vignette" class="hcf-vignette s07-vignette" picking-mode="Ignore" />

        <ui:VisualElement name="crosshair" class="hcf-abs s07-crosshair" picking-mode="Ignore" />

        <ui:VisualElement name="objective" class="hcf-abs s07-objective">
            <ui:Label text="OBJECTIVE" class="hcf-mono s07-objective__kicker" />
            <ui:Label text="FIND THE INTAKE LEDGER" name="objective-title" class="hcf-bs-700 s07-objective__title" />
        </ui:VisualElement>

        <ui:VisualElement name="vitals" class="hcf-abs s07-vitals">
            <ui:VisualElement name="condition-row" class="s07-condition">
                <ui:Label text="CONDITION" class="hcf-mono s07-condition__label" />
                <ui:Label text="bleeding" name="condition-value" class="hcf-typed s07-condition__value" />
            </ui:VisualElement>
            <hcf:HcfSegmentedMeter name="meter-health" class="s07-health" segments="7" filled="4" accent-from="3" gap="4" />
            <ui:VisualElement name="stamina-row" class="s07-stamina">
                <ui:Label text="STAM" class="hcf-mono s07-stamina__label" />
                <ui:VisualElement name="stamina-track" class="s07-stamina__track">
                    <ui:VisualElement name="stamina-fill" class="s07-stamina__fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gear" class="hcf-abs s07-gear">

            <ui:VisualElement name="quick">
                <ui:Label text="QUICK" class="hcf-mono s07-cap" />
                <ui:VisualElement name="quick-slots" class="s07-quick__row">
                    <ui:Button name="cell-01" text="" class="s07-slot s07-slot--first s07-slot--idle">
                        <ui:VisualElement class="hcf-abs s07-slot__hatch" picking-mode="Ignore" />
                        <ui:VisualElement name="art-01" class="hcf-abs s07-slot-art" picking-mode="Ignore" />
                        <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                        <ui:Label text="1" class="hcf-abs hcf-mono s07-slot__index" />
                    </ui:Button>
                    <ui:Button name="cell-02" text="" class="s07-slot s07-slot--idle is-active">
                        <ui:VisualElement class="hcf-abs s07-slot__hatch" picking-mode="Ignore" />
                        <ui:VisualElement name="art-02" class="hcf-abs s07-slot-art" picking-mode="Ignore" />
                        <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                        <ui:Label text="2" class="hcf-abs hcf-mono s07-slot__index" />
                        <ui:Label text="×2" class="hcf-abs hcf-mono s07-slot__count" />
                    </ui:Button>

                    <ui:Button name="cell-03" text="" class="s07-slot">
                        <hcf:HcfDashedFrame class="hcf-abs s07-slot__dash" line-width="1" dash="3" gap="3" picking-mode="Ignore" />
                        <ui:VisualElement name="art-03" class="hcf-abs s07-slot-art" picking-mode="Ignore" />
                        <ui:VisualElement class="hcf-focus-ring" picking-mode="Ignore" />
                        <ui:Label text="3" class="hcf-abs hcf-mono s07-slot__index s07-slot__index--empty" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="torch" class="s07-torch">
                <ui:Label text="TORCH" class="hcf-mono s07-cap" />
                <hcf:HcfSegmentedMeter name="meter-torch" class="s07-torch__meter" segments="5" filled="2" gap="4" />
                <ui:Label text="2 cells left" name="torch-note" class="hcf-typed s07-torch__note" />
            </ui:VisualElement>

            <ui:VisualElement name="ammo" class="s07-ammo">
                <ui:Label text="REVOLVER" class="hcf-mono s07-cap s07-ammo__cap" />
                <ui:VisualElement name="ammo-row" class="s07-ammo__row">
                    <ui:Label text="04" name="ammo-current" class="hcf-bs-900 s07-ammo__current" />
                    <ui:Label text="/ 12" name="ammo-total" class="hcf-bs-700 s07-ammo__total" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="hints" class="hcf-abs hcf-hint-row s07-hints" picking-mode="Ignore">
            <ui:VisualElement class="hcf-hint-item hcf-hint-item--first">
                <ui:Label class="hcf-keycap" text="I" />
                <ui:Label text="inventory" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="J" />
                <ui:Label text="journal" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="M" />
                <ui:Label text="map" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="O" />
                <ui:Label text="objectives" />
            </ui:VisualElement>
            <ui:VisualElement class="hcf-hint-item">
                <ui:Label class="hcf-keycap" text="ESC" />
                <ui:Label text="pause" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="notifications" class="hcf-abs s07-notify" picking-mode="Ignore">

            <ui:VisualElement name="notify-stack" class="hcf-abs s07-notify-stack" picking-mode="Ignore">

                <ui:VisualElement name="notify-pickup" class="s07-notify-item s07-notify-note" picking-mode="Ignore">
                    <ui:VisualElement class="s07-notify-note__icon" picking-mode="Ignore">
                        <ui:VisualElement class="hcf-abs s07-notify-note__hatch" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="s07-notify-note__body" picking-mode="Ignore">
                        <ui:Label text="PICKED UP" class="hcf-mono s07-notify-note__kicker" picking-mode="Ignore" />
                        <ui:Label text="BANDAGE ×2" class="hcf-bs-800 s07-notify-note__title" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="notify-document" class="s07-notify-item s07-notify-note s07-notify-note--cream s07-notify-note--next" picking-mode="Ignore">
                    <ui:VisualElement class="s07-notify-note__icon" picking-mode="Ignore">
                        <ui:VisualElement class="hcf-abs s07-notify-note__hatch" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="s07-notify-note__body" picking-mode="Ignore">
                        <ui:Label text="ADDED TO DOCUMENTS" class="hcf-mono s07-notify-note__kicker" picking-mode="Ignore" />
                        <ui:Label text="NIGHT ROTA" class="hcf-bs-800 s07-notify-note__title" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="notify-autosave" class="hcf-abs s07-notify-item s07-notify-autosave" picking-mode="Ignore">
                <ui:VisualElement class="s07-notify-autosave__dot" picking-mode="Ignore" />
                <ui:Label text="AUTOSAVING — DO NOT QUIT" class="hcf-mono s07-notify-autosave__label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="notify-objective" class="hcf-abs s07-notify-item s07-notify-toast" picking-mode="Ignore">

                <ui:VisualElement name="objective-toast-card" picking-mode="Ignore">
                    <hcf:HcfTornPlate class="s09-toast__plate" cut-top="5" cut-right="2.8" cut-bottom="4.6" cut-left="2.8" picking-mode="Ignore" />
                    <ui:VisualElement class="s07-notify-toast__content" picking-mode="Ignore">
                        <ui:Label text="OBJECTIVE COMPLETE" class="hcf-mono s07-notify-toast__kicker" picking-mode="Ignore" />
                        <ui:Label text="REACH THE SECOND LANDING" name="toast-title" class="hcf-bs-900 s07-notify-toast__title" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="notify-chapter" class="hcf-abs s07-notify-item s07-notify-chapter" picking-mode="Ignore">
                <ui:Label text="CHAPTER THREE" class="hcf-mono s07-notify-chapter__kicker" picking-mode="Ignore" />
                <ui:Label text="NORTH WING" class="hcf-bs-900 s07-notify-chapter__title" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>

        <hcf:HcfGrainOverlay name="grain" grain="55" scanlines="false" />

    </ui:VisualElement>
</ui:UXML>
